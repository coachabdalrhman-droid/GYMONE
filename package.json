{
  "name": "gym-jalaa-pro",
  "productName": "جيم الجلاء برو",
  "version": "1.0.0",
  "description": "نظام إدارة اشتراكات جيم الجلاء الرياضي",
  "main": "electron-main.js",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "electron .",
    "dist:win": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "recharts": "2.15.0",
    "xlsx": "0.18.5"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "5.7.3",
    "vite": "^6.1.0"
  },
  "build": {
    "appId": "com.jalaa.gym.pro",
    "productName": "جيم الجلاء برو",
    "asar": true,
    "directories": {
      "output": "dist-exe"
    },
    "files": [
      "dist/**/*",
      "electron-main.js",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "جيم الجلاء برو"
    }
  }
}
